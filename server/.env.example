# Copy this file to ".env" and adjust the values for your machine.
# NEVER commit the real .env - it contains secrets.

# HTTP port the Node API listens on (Vite proxies /api to this).
PORT=4000

# Existing MySQL database (do NOT rename - data must be preserved).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=maranao_treasures_db

# JWT signing secret. Must be 32+ random characters.
# If omitted, the server falls back to the file below so existing tokens
# issued by the old PHP API keep working after the migration.
JWT_SECRET=
JWT_SECRET_FILE=C:\xampp\maranao_jwt_secret.txt

# Comma-separated list of browser origins allowed to call the API.
# In development the Vite proxy makes calls same-origin, so this is mainly
# used when you open the API directly.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Where uploaded images are written / served from.
UPLOAD_DIR=uploads

# Set to "production" to hide internal error details from responses.
NODE_ENV=development
